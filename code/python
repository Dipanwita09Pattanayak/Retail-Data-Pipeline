import pandas as pd
import numpy as np
import hashlib

import warnings
warnings.filterwarnings("ignore")

from google.colab import files
uploaded = files.upload()

file_path = "USECASE - Data Engineering.xlsx"

product_df = pd.read_excel(file_path, sheet_name="product_details")
retail1 = pd.read_excel(file_path, sheet_name="retail_data1")
retail2 = pd.read_excel(file_path, sheet_name="retail_data2")

print("Product Shape:", product_df.shape)
print("Retail1 Shape:", retail1.shape)
print("Retail2 Shape:", retail2.shape)

retail_df = pd.concat([retail1, retail2], ignore_index=True)

print("Combined Shape:", retail_df.shape)

before = len(retail_df)

retail_df = retail_df.drop_duplicates()

after = len(retail_df)

print(f"Duplicates Removed: {before-after}")

retail_df.columns = retail_df.columns.str.lower().str.strip()

product_df.columns = product_df.columns.str.lower().str.strip()

category_mapping = {
    "ELEC": "Electronics",
    "electronics": "Electronics",
    "Electronics": "Electronics",

    "cloth": "Clothing",
    "clothing": "Clothing",
    "Clothing": "Clothing",

    "FURN": "Furniture",
    "furniture": "Furniture",
    "Furniture": "Furniture",

    "home appliances": "Home Appliances",
    "HOME APPLIANCES": "Home Appliances",
    "Home Appliances": "Home Appliances"
}

retail_df["category"] = retail_df["category"].replace(category_mapping)

product_mapping = {
    "Tv": "TV",
    "tv": "TV",

    "sofa": "Sofa",

    "DINING TABLE": "Dining Table",
    "dining table": "Dining Table",

    "Mixer grinder": "Mixer Grinder",
    "mixer grinder": "Mixer Grinder",

    "REFRIGERATOR": "Refrigerator",
    "refrigerator": "Refrigerator"
}

retail_df["product_name"] = retail_df["product_name"].replace(product_mapping)

retail_df["quantity"] = retail_df["quantity"].fillna(1)

retail_df["discount"] = retail_df["discount"].fillna(0)

price_map = dict(zip(product_df["product_id"],
                     product_df["price"]))

retail_df["price"] = retail_df.apply(
    lambda row:
    price_map.get(row["product_id"], np.nan)
    if pd.isna(row["price"])
    else row["price"],
    axis=1
)

retail_df["transaction_date"] = pd.to_datetime(
    retail_df["transaction_date"],
    errors="coerce"
)

retail_df = retail_df[retail_df["quantity"] > 0]

retail_df = retail_df[retail_df["price"] > 0]

def hash_text(text):
    return hashlib.sha256(
        str(text).encode()
    ).hexdigest()

retail_df["email_masked"] = retail_df["email"].apply(hash_text)

retail_df["phone_masked"] = retail_df["phone"].apply(hash_text)

retail_df.drop(
    columns=["email", "phone"],
    inplace=True
)

product_df.rename(
    columns={
        "price": "standard_price",
        "category": "master_category"
    },
    inplace=True
)

retail_df = retail_df.merge(
    product_df,
    on="product_id",
    how="left",
    suffixes=("", "_master")
)

retail_df["gross_amount"] = (
    retail_df["price"]
    * retail_df["quantity"]
)

retail_df["discount_amount"] = (
    retail_df["gross_amount"]
    * retail_df["discount"]
)

retail_df["net_revenue"] = (
    retail_df["gross_amount"]
    - retail_df["discount_amount"]
)

total_revenue = retail_df["net_revenue"].sum()

total_orders = retail_df["transaction_id"].nunique()

avg_order_value = (
    retail_df["net_revenue"].sum()
    /
    total_orders
)

print("\n KPI ")
print("Total Revenue:", round(total_revenue,2))
print("Total Orders:", total_orders)
print("Average Order Value:", round(avg_order_value,2))

revenue_category = (
    retail_df.groupby("category")
    ["net_revenue"]
    .sum()
    .reset_index()
    .sort_values(
        "net_revenue",
        ascending=False
    )
)

print("\nRevenue By Category")
print(revenue_category)

revenue_city = (
    retail_df.groupby("city")
    ["net_revenue"]
    .sum()
    .reset_index()
    .sort_values(
        "net_revenue",
        ascending=False
    )
)

print("\nRevenue By City")
print(revenue_city)

top_products = (
    retail_df.groupby("product_name")
    ["net_revenue"]
    .sum()
    .reset_index()
    .sort_values(
        "net_revenue",
        ascending=False
    )
)

print("\nTop Products")
print(top_products.head(10))

retail_df["month"] = (
    retail_df["transaction_date"]
    .dt.to_period("M")
    .astype(str)
)

monthly_sales = (
    retail_df.groupby("month")
    ["net_revenue"]
    .sum()
    .reset_index()
)

retail_df.to_csv(
    "cleaned_retail_data.csv",
    index=False
)

revenue_category.to_csv(
    "revenue_by_category.csv",
    index=False
)

revenue_city.to_csv(
    "revenue_by_city.csv",
    index=False
)

monthly_sales.to_csv(
    "monthly_sales.csv",
    index=False
)

top_products.to_csv(
    "top_products.csv",
    index=False
)

print("\nFiles Exported Successfully")

